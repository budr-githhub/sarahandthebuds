---
import BaseLayout from "../layouts/BaseLayout.astro";
import songbook from "../data/songbook.json";

// Migrated from Plan & Adapt; see docs/migration.md.
const bookingContexts = [
  "Private parties",
  "Corporate events",
  "Wineries & breweries",
  "Festivals",
  "Weddings",
  "Porch concerts",
  "Restaurants",
  "Holiday parties",
];

// Sample repertoire, organized by artist and alphabetized by artist then
// song (a leading "The" is ignored for sorting). Drawn title-level from the
// band's own master song list; a small sample of a 180+ song book.
const coversByArtist = songbook.sample;
// Pack titles into readable compact lines; mobile wraps instead of hiding titles.
const songRows = coversByArtist.flatMap(({artist, songs}) => {
  const groups: string[][] = [];
  for (const song of songs) {
    const last = groups.at(-1);
    if (last && [...last, song].join(" · ").length <= 44) last.push(song);
    else groups.push([song]);
  }
  return groups.map((songs) => ({artist, songs}));
});

// Real original titles from the "Our Songs" section of the master list,
// alphabetized.
const originals = [
  "All the Real Girls",
  "Bloom",
  "Down to the River",
  "Drive You Crazy",
  "Going to Memphis",
  "Home",
  "Hope and Peace",
  "Met My Muse",
  "Met You in Nashville (Sha La La)",
  "Promised Land",
  "Saint Margaret's Hope",
  "This Country",
  "Under a Falling Moon",
  "When You Loved Me",
];

const introductions = [
  {
    "src": "/images/music/sarah-and-the-buds-georgetown-underground-portrait.webp",
    "alt": "The four members of Sarah & the Buds holding Georgetown Underground stickers.",
    "width": 1636,
    "height": 1920
  },
  {
    "src": "/images/music/sarah-and-bud-portrait-with-guitar-and-microphone.webp",
    "alt": "Sarah & Bud smiling with an acoustic guitar and microphone.",
    "width": 1536,
    "height": 1864
  }
];

const newPhotos = [
  {
    "src": "/images/music/sarah-and-bud-performing-beside-wine-barrels.webp",
    "alt": "Sarah & Bud performing beside wine barrels.",
    "width": 1440,
    "height": 1440
  },
  {
    "src": "/images/music/sarah-and-the-buds-performing-in-wine-barrel-room.webp",
    "alt": "Sarah & the Buds performing with vocals, guitar, drums and bass in a wine-barrel room.",
    "width": 1920,
    "height": 1440
  },
  {
    "src": "/images/music/sarah-and-the-buds-band-portrait-in-barn.webp",
    "alt": "The four members of Sarah & the Buds smiling together in a wooden barn.",
    "width": 1920,
    "height": 1268
  },
  {
    "src": "/images/music/sarah-and-the-buds-outdoor-crowd-selfie.webp",
    "alt": "Sarah & the Buds taking an outdoor group selfie with a crowd.",
    "width": 1920,
    "height": 1440
  },
  {
    "src": "/images/music/sarah-and-the-buds-georgetown-storefront-with-show-sign.webp",
    "alt": "Sarah & the Buds outside Georgetown Underground beside a chalkboard show sign.",
    "width": 1920,
    "height": 1440
  }
];

const gallery = [
  { src: "/images/music/sarah-and-buds-georgetown-underground.webp", alt: "Sarah & the Buds outside Georgetown Underground with a chalkboard sign from a past show." },
  { src: "/images/music/facebook/sarah-and-buds-cover-band.jpg", alt: "Sarah & the Buds performing together as a full band." },
  { src: "/images/music/facebook/sarah-and-buds-stage-performance.jpg", alt: "Sarah & the Buds performing on an indoor stage." },
  { src: "/images/music/facebook/sarah-and-buds-porch-performance.jpg", alt: "Sarah & Bud playing an acoustic set on a porch." },
  { src: "/images/music/facebook/sarah-singing-porch.jpg", alt: "Sarah singing during a porch performance." },
  { src: "/images/music/facebook/bud-bass-porch.jpg", alt: "Bud playing bass at an outdoor show." },
  { src: "/images/music/facebook/porchfest-crowd.jpg", alt: "A crowd gathered for an outdoor porch concert." },
];

const musicGroupSchema = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: "Sarah & the Buds",
  genre: ["Rock", "Country", "Americana", "Folk", "Pop"],
  areaServed: "Lexington and Midway, Kentucky area",
  email: "booksarahandbud@gmail.com",
};
---

<BaseLayout
  title="Sarah & the Buds"
  description="Sarah & the Buds (full band) and the Sarah & Bud acoustic duo: live music for weddings, wineries, festivals, and parties around Lexington and Midway, Kentucky."
  ogImage="/images/music/facebook/sarah-and-buds-cover-band.jpg"
  ogImageAlt="Sarah & the Buds performing together as a full band."
  structuredData={musicGroupSchema}
>
  <div class="page-container music-page" id="top" tabindex="-1">
    <div class="page-content text-container">
      <div class="brand-intro"><img class="brand-mark" src="/images/brand/sb-mark.png" alt="S&B microphone mark" width="1124" height="797" /><h1>Sarah &amp; the Buds</h1></div>
      <p class="lede">
        <strong>Sarah &amp; the Buds</strong> is a full band built for singing
        along. <strong>Sarah &amp; Bud</strong> is the acoustic duo version of
        the same thing, for smaller rooms and porches.
      </p>

      <div class="music-actions">
        <a class="button button-primary" href="/shows">Upcoming shows</a>
        <a
          class="button button-secondary"
          href="mailto:booksarahandbud@gmail.com?subject=Booking%20inquiry"
          >Book the band</a
        >
      </div>

      <nav class="music-sections" aria-label="Music page sections">
        <p>On this page</p>
        <ul>
          <li><a href="#band-and-duo">Band &amp; duo</a></li>
          <li><a href="#where-we-play">Where we play</a></li>
          <li><a href="#photos">Photos</a></li>
          <li><a href="#songbook">Songbook</a></li>
          <li><a href="#originals">Originals</a></li>
          <li><a href="#holidays">Holidays</a></li>
          <li><a href="#follow-along">Follow along</a></li>
        </ul>
      </nav>
    </div>

    <div class="music-hero">
      <div class="image-frame">
        <img
          src="/images/music/sarah-and-the-buds-band-only-hero.webp"
          width="1542" height="1020" fetchpriority="high"
          alt="The four members of Sarah & the Buds smiling together against a dark background."
        />
      </div>
    </div>

    <div class="page-content text-container">
      <p>
        The set list is familiar and fun: rock, country, Americana, folk, and
        pop you already know, played so people can sing along. Woven through it
        are the band's own originals, which are as much a part of a night as
        the covers.
      </p>

      <h2 id="band-and-duo" tabindex="-1">The band and the duo</h2>
      <p>
        <strong>Sarah &amp; the Buds</strong> is the full-band experience, with
        more sound and more energy for a bigger room or event. <strong
          >Sarah &amp; Bud</strong
        > is the acoustic duo.
      </p>

      <div class="introduction-photos">
        {introductions.map((photo) => (
          <figure>
            <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>

      <a class="back-to-top" href="#top">Back to top ↑</a>

      <h2 id="where-we-play" tabindex="-1">Where they play</h2>
      <p>Sarah &amp; the Buds and Sarah &amp; Bud are available for:</p>
      <ul class="booking-contexts">
        {bookingContexts.map((c) => <li>{c}</li>)}
      </ul>
      <p>
        Booking pricing is available on request. To check a date or ask about a
        show, email <a href="mailto:booksarahandbud@gmail.com?subject=Booking%20inquiry"
          >booksarahandbud@gmail.com</a
        >.
      </p>
      <a class="back-to-top" href="#top">Back to top ↑</a>
    </div>

    <section aria-labelledby="photos">
      <h2 id="photos" tabindex="-1">Photos</h2>
      <div class="photo-gallery">
        {[...gallery, ...newPhotos].map((photo) => (
          <div class="image-frame">
            <img src={photo.src} alt={photo.alt}
              width={"width" in photo ? photo.width : undefined}
              height={"height" in photo ? photo.height : undefined}
              loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <a class="back-to-top" href="#top">Back to top ↑</a>
    </section>

    <div class="page-content text-container">
      <h2 id="songbook" tabindex="-1">A taste of the songbook</h2>
      <p>
        This is just a taste of our songbook—there are many more songs available.
        <a href="/songbook">See the full song list &rarr;</a>
        Sarah &amp; the Buds also take requests; if you have a song in mind for
        your event, just ask.
      </p>
      <details class="songbook-panel">
        <summary>Browse the songbook <span>({coversByArtist.reduce((count, artist) => count + artist.songs.length, 0)} songs · {coversByArtist.length} artists)</span></summary>
        <ul class="repertoire songbook-rows">
          {songRows.map((row) => (
            <li><span class="repertoire-artist">{row.artist}</span><span class="repertoire-songs">{row.songs.join(" · ")}</span></li>
          ))}
        </ul>
      </details>


      <a class="back-to-top" href="#top">Back to top ↑</a>

      <h2 id="originals" tabindex="-1">Originals</h2>
      <p>
        The band writes and performs its own songs, more than forty of them,
        as a real part of the act, not an afterthought. A few:
      </p>
      <ul class="repertoire repertoire--originals">
        {originals.map((o) => <li>{o}</li>)}
      </ul>

      <a class="back-to-top" href="#top">Back to top ↑</a>

      <h2 id="holidays" tabindex="-1">Holidays</h2>
      <p>
        For December bookings, the set makes room for Christmas favorites,
        from "Feliz Navidad" to "Fairytale of New York," alongside Bud's
        original holiday song, "Merry Mary."
      </p>

      <a class="back-to-top" href="#top">Back to top ↑</a>

      <h2 id="follow-along" tabindex="-1">Follow along</h2>
      <p>
        See and hear more on <a href="https://www.instagram.com/sarah.and.bud/"
          >Instagram</a
        >, <a href="https://www.youtube.com/@sarahandbud">YouTube</a>, and <a
          href="https://www.facebook.com/sarahandbud">Facebook</a
        >.
      </p>

      <p>
        <a href="/shows">See upcoming shows &rarr;</a>
      </p>

      <p>
        <a class="button button-primary" href="mailto:booksarahandbud@gmail.com?subject=Booking%20inquiry"
          >Email Sarah &amp; Bud booking</a
        >
      </p>
      <a class="back-to-top" href="#top">Back to top ↑</a>
    </div>
  </div>
</BaseLayout>

<style>
  .songbook-rows li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 12px; padding-block: 8px; }
  .songbook-rows .repertoire-artist { flex-shrink: 0; }
  .back-to-top { display: inline-block; padding-block: 12px; font-size: var(--text-small); }
  @media (max-width: 600px) { .songbook-rows li { display: block; } }

  .songbook-panel { margin-block: 24px; border-block: 1px solid var(--color-muted); }
  .songbook-panel summary { cursor: pointer; padding-block: 14px; font-weight: 600; }
  .songbook-panel summary span { font-size: var(--text-small); font-weight: 400; }
  .songbook-panel summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .introduction-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-block: 24px 32px;
    align-items: start;
  }
  .introduction-photos figure { margin: 0; min-width: 0; }
  .introduction-photos img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5;
    object-fit: cover; object-position: center; border-radius: 8px;
  }
  .photo-gallery { columns: 3; column-gap: 16px; }
  .photo-gallery .image-frame { break-inside: avoid; margin-bottom: 16px; }
  .photo-gallery img { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) { .photo-gallery { columns: 2; } }
  @media (max-width: 600px) {
    .introduction-photos { grid-template-columns: 1fr; }
    .photo-gallery { columns: 1; }
  }

  .music-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .music-actions .button {
    padding-inline: var(--space-3);
  }

  .music-sections {
    margin-top: var(--space-4);
    padding: var(--space-3) 0;
    border-block: 1px solid var(--color-muted);
  }

  .music-sections p {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 700;
  }

  .music-sections ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .music-sections a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-2);
    text-underline-offset: 0.2em;
  }

  /* Leave room for a wrapped header if it becomes sticky. Native fragment
     navigation stays instant, including with reduced-motion preferences. */
  h2[id] {
    scroll-margin-top: calc(var(--space-8) + var(--space-5));
  }

  h2[id]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
